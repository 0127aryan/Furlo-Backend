# Supabase — use service_role key (never the anon key) so RLS is bypassed server-side
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Postgres URI for npm run migrate — use Session pooler from Dashboard → Database → Connection string
# (direct db.<ref>.supabase.co is IPv6-only and may fail ENOTFOUND on some networks)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Public anon key for GET /auth/supabase-config (mobile Realtime). Never the service_role key.
SUPABASE_ANON_KEY=your_supabase_anon_key

# JWT secret for verifying access tokens (rate limits + same value as Supabase API JWT secret)
SUPABASE_JWT_SECRET=

# Rate limiting (optional — defaults in lib/rateLimitConfig.ts)
# RATE_LIMIT_AUTH_EMAIL_CAPACITY=10
# RATE_LIMIT_AUTH_EMAIL_WINDOW_MS=900000
# RATE_LIMIT_AUTH_IP_CAPACITY=50
# RATE_LIMIT_AUTH_IP_WINDOW_MS=3600000
# RATE_LIMIT_PUBLIC_IP_PER_MIN=80
# RATE_LIMIT_USER_FREE_PER_MIN=100
# RATE_LIMIT_USER_PAID_PER_MIN=1000
# RATE_LIMIT_USER_ADMIN_PER_MIN=500
# RATE_LIMIT_AUTH_BACKOFF_MAX_SEC=32
# POST_RATE_LIMIT_PER_HOUR=10

# Sentry — API error monitoring (prod-only when NODE_ENV=production)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Server
PORT=

# CORS — exact URL of the frontend (no trailing slash)
FRONTEND_URL=

# OAuth: web fallback when FRONTEND_URL is localhost (must be in Supabase Redirect URLs).
OAUTH_REDIRECT_BASE_URL=https://dev.furlopets.in
# Mobile Google sign-in should use a deep link (default furlo://auth/callback), not the web URL.
# MOBILE_OAUTH_REDIRECT_URL=furlo://auth/callback
# Optional comma-separated hostnames allowed for HTTPS ?redirect_to= (with ?client=mobile only)
# OAUTH_ALLOWED_CALLBACK_HOSTS=dev.furlopets.in,furlopets.in
