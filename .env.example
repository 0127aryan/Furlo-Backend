# Supabase — use service_role key (never the anon key) so RLS is bypassed server-side
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Public anon key for GET /auth/supabase-config (mobile Realtime). Never the service_role key.
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server
PORT=

# CORS — exact URL of the frontend (no trailing slash)
FRONTEND_URL=
