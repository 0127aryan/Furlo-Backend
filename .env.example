# Supabase — use service_role key (never the anon key) so RLS is bypassed server-side
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Postgres URI for npm run migrate — use Session pooler from Dashboard → Database → Connection string
# (direct db.<ref>.supabase.co is IPv6-only and may fail ENOTFOUND on some networks)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Public anon key for GET /auth/supabase-config (mobile Realtime). Never the service_role key.
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server
PORT=

# CORS — exact URL of the frontend (no trailing slash)
FRONTEND_URL=

# OAuth: web fallback when FRONTEND_URL is localhost (must be in Supabase Redirect URLs).
OAUTH_REDIRECT_BASE_URL=https://dev.furlopets.in
# Mobile Google sign-in should use a deep link (default furlo://auth/callback), not the web URL.
# MOBILE_OAUTH_REDIRECT_URL=furlo://auth/callback
# Optional comma-separated hostnames allowed for HTTPS ?redirect_to= (with ?client=mobile only)
# OAUTH_ALLOWED_CALLBACK_HOSTS=dev.furlopets.in,furlopets.in
